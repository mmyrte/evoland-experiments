@charset = UTF-8
// Dinamica EGO Weights of Evidence calibration for the PIE benchmark (1985 -> 1991).
// Run from a work directory holding lu_1985.tif, lu_1991.tif and ef_00{1,2,3}.tif;
// writes ranges.dcf and weights.dcf (and the WoE report tables) there.
Script {{
    initial := LoadCategoricalMap { filename = "lu_1985.tif", nullValue = .none, storageMode = .default };
    final := LoadCategoricalMap { filename = "lu_1991.tif", nullValue = .none, storageMode = .default };
    ef1 := LoadMap { filename = "ef_001.tif", nullValue = .none, storageMode = .default };
    ef2 := LoadMap { filename = "ef_002.tif", nullValue = .none, storageMode = .default };
    ef3 := LoadMap { filename = "ef_003.tif", nullValue = .none, storageMode = .default };

    staticVars := CreateCubeMap .float32 .default {{
        NumberAndNameMap ef1 "ef_001" 1;
        NumberAndNameMap ef2 "ef_002" 2;
        NumberAndNameMap ef3 "ef_003" 3;
    }};

    // dynamic variables, recomputed from the anterior map in simulate.ego
    distances := CalcDistanceMap initial [1, 2, 3] .float32 .default .no;

    // increment (map units), minimum and maximum delta (cells), tolerance angle (degrees):
    // the defaults Dinamica's GUI proposes, with increments of about one cell for distances
    skeleton := WeightsOfEvidenceSkeleton [
        1->2 [
            "static_var/ef_001" 5 500000 1 5,
            "static_var/ef_002" 1 500000 1 5,
            "static_var/ef_003" 100 500000 1 5,
            "distance_to/distance_to_2" 100 500000 1 5,
            "distance_to/distance_to_3" 100 500000 1 5
        ],
        1->3 [
            "static_var/ef_001" 5 500000 1 5,
            "static_var/ef_002" 1 500000 1 5,
            "static_var/ef_003" 100 500000 1 5,
            "distance_to/distance_to_2" 100 500000 1 5,
            "distance_to/distance_to_3" 100 500000 1 5
        ],
        2->3 [
            "static_var/ef_001" 5 500000 1 5,
            "static_var/ef_002" 1 500000 1 5,
            "static_var/ef_003" 100 500000 1 5,
            "distance_to/distance_to_1" 100 500000 1 5,
            "distance_to/distance_to_3" 100 500000 1 5
        ],
        3->1 [
            "static_var/ef_001" 5 500000 1 5,
            "static_var/ef_002" 1 500000 1 5,
            "static_var/ef_003" 100 500000 1 5,
            "distance_to/distance_to_1" 100 500000 1 5,
            "distance_to/distance_to_2" 100 500000 1 5
        ],
        3->2 [
            "static_var/ef_001" 5 500000 1 5,
            "static_var/ef_002" 1 500000 1 5,
            "static_var/ef_003" 100 500000 1 5,
            "distance_to/distance_to_1" 100 500000 1 5,
            "distance_to/distance_to_2" 100 500000 1 5
        ]
    ];

    ranges := DetermineWeightsOfEvidenceRanges initial final skeleton .no .no {{
        NameMap staticVars "static_var";
        NameMap distances "distance_to";
    }};
    weights report := DetermineWeightsOfEvidenceCoefficients initial final ranges .no .no {{
        NameMap staticVars "static_var";
        NameMap distances "distance_to";
    }};
    correlation := DetermineWeightsOfEvidenceCorrelation ranges [1->2, 1->3, 2->3, 3->1, 3->2] {{
        NameMap staticVars "static_var";
        NameMap distances "distance_to";
    }};

    SaveWeights { weights = ranges, filename = "ranges.dcf" };
    SaveWeights { weights = weights, filename = "weights.dcf" };
    SaveTable { table = report, filename = "weights_report.csv" };
    SaveTable { table = correlation, filename = "weights_correlation.csv" };
}};
